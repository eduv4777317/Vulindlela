@model ConfirmationViewModel
@{
    ViewData["Title"] = "Booked";
}
<h1>You are booked</h1>
<dl>
    <dt>Reference</dt>
    <dd>@Model.Appointment.Id</dd>
    <dt>Branch</dt>
    <dd>@Model.BranchName</dd>
    <dt>When</dt>
    <dd>@Model.Appointment.StartsAt?.ToString("dddd d MMMM yyyy, HH:mm")</dd>
    <dt>Service</dt>
    <dd>@Model.Appointment.ServiceType</dd>
</dl>
<p>Next, send your documents so we can tell you before you travel whether anything is missing.</p>
<p>
    <a class="button" asp-controller="Appointments" asp-action="Documents" asp-route-id="@Model.Appointment.Id"
       asp-route-citizenId="@Model.Appointment.CitizenId">Submit documents</a>
    <a class="button secondary" asp-controller="Appointments" asp-action="Index"
       asp-route-citizenId="@Model.Appointment.CitizenId">My appointments</a>
</p>
