@model BookViewModel
@{
    ViewData["Title"] = "Confirm your booking";
}
<h1>Confirm your booking</h1>
<p><strong>@Model.BranchName</strong>, @Model.StartsAt.ToString("dddd d MMMM yyyy, HH:mm")</p>

@if (Model.Error is not null)
{
    <p class="notice">@Model.Error</p>
}

@if (Model.SlotTaken)
{
    <p><a asp-action="Index" asp-route-branchId="@Model.BranchId">Choose another slot</a></p>
}
else
{
    <form asp-action="Book" method="post">
        <input type="hidden" asp-for="SlotId" />
        <input type="hidden" asp-for="BranchId" />
        <input type="hidden" asp-for="StartsAt" />

        <label asp-for="ServiceType">Service</label>
        <select asp-for="ServiceType" required>
            @foreach (var serviceType in Model.ServiceTypes)
            {
                <option value="@serviceType">@serviceType</option>
            }
        </select>

        <button type="submit">Book this slot</button>
    </form>
}
