<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await RenderSectionAsync("Head", required: false)
    <title>@ViewData["Title"] - Vulindlela</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a class="brand" asp-controller="Home" asp-action="Index">Vulindlela</a>
            <a asp-controller="Booking" asp-action="Index">Book a slot</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Appointments" asp-action="Index">@(User.IsInRole(Roles.Official) ? "Citizen records" : "My appointments")</a>
                <a asp-controller="AccessLog" asp-action="Index">Access log</a>
                <span class="signed-in">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="SignOut" method="post" class="nav-form">
                    <button type="submit" class="link">Sign out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="SignIn">Sign in</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>National Civic Services Agency</footer>
</body>
</html>
