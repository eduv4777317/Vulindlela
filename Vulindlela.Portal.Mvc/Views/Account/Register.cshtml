@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<h1>Register</h1>

@if (Model.Error is not null)
{
    <p class="notice">@Model.Error</p>
}

<form asp-action="Register" method="post">
    <label asp-for="CitizenId"></label>
    <input asp-for="CitizenId" maxlength="13" autocomplete="username" required />

    <label asp-for="DisplayName"></label>
    <input asp-for="DisplayName" autocomplete="name" required />

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="new-password" required />

    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" required />
    <span asp-validation-for="ConfirmPassword" class="field-error"></span>

    <button type="submit">Create account</button>
</form>

<p>Already registered? <a asp-action="SignIn">Sign in</a>.</p>
