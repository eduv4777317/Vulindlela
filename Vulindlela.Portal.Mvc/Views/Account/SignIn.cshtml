@model SignInViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>

@if (Model.Error is not null)
{
    <p class="notice">@Model.Error</p>
}

<form asp-action="SignIn" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Username"></label>
    <input asp-for="Username" autocomplete="username" required />

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="current-password" required />

    <button type="submit">Sign in</button>
</form>

<p>No account yet? <a asp-action="Register">Register with your ID number</a>.</p>
